<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Versão .NET 10 para o OpenWigiDashManager (branch main). A branch legacy-net472 guarda a tentativa net472, que
       parou no erro 4001 do WebSocket; esta fala com o Discord pelo named pipe discord-ipc-N. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WigiDash.DiscordWidget</RootNamespace>
    <AssemblyName>DiscordWidget</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Authors>Victor Perez</Authors>
    <Product>Discord</Product>
    <Description>Controle do Discord no WigiDash (OpenWigiDashManager): mute, deafen, canais, volume, soundboard.</Description>
  </PropertyGroup>

  <!-- `dotnet pack` gera o pacote de plugin para o nuget.org (docs/sdk.md do OpenWigiDashManager,
       "Publicar no nuget.org"). Enquanto o SDK for preview, o plugin também é (NU5104). -->
  <PropertyGroup>
    <OpenWigiDashPlugin>true</OpenWigiDashPlugin>
    <PackageId>victorperez2911.OpenWigiDash.Discord</PackageId>
    <Title>Discord</Title>
    <Version>2.0.0-preview.3</Version>
    <PackageTags>discord</PackageTags>
    <PackageProjectUrl>https://github.com/victorperez2911/WigiDash-DiscordWidGet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/victorperez2911/WigiDash-DiscordWidGet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <!-- O SDK vem do nuget.org. Para testar mudanças no SDK antes de publicar, compile com
       -p:UseLocalOpenWigiSdk=true e o repo OpenWigiDashManager clonado ao lado deste. -->
  <PropertyGroup>
    <OpenWigiSdkVersion>2.0.0-preview.3</OpenWigiSdkVersion>
    <OpenWigiSdkProject Condition="'$(OpenWigiSdkProject)' == ''">$(MSBuildThisFileDirectory)..\OpenWigiDashManager\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj</OpenWigiSdkProject>
  </PropertyGroup>

  <!-- Contrato e UI vêm do host (uma cópia só): o plugin compila contra eles mas não leva junto. -->
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' == 'true'">
    <ProjectReference Include="$(OpenWigiSdkProject)" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' != 'true'">
    <PackageReference Include="victorperez2911.OpenWigi.Sdk" Version="$(OpenWigiSdkVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <!-- Pelo pacote, o NuGet importa o .targets do SDK sozinho; pela referência de projeto, importamos à mão. -->
  <Import Project="$([System.IO.Path]::GetDirectoryName($(OpenWigiSdkProject)))\build\victorperez2911.OpenWigi.Sdk.targets"
          Condition="'$(UseLocalOpenWigiSdk)' == 'true'" />

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" Condition="Exists('icon.png')" />
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Remove="discord_app_icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DiscordWidget.Tests" />
  </ItemGroup>

  <!-- Os testes têm projeto próprio. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Content Remove="tests\**" />
    <None Remove="tests\**" />
  </ItemGroup>

</Project>
