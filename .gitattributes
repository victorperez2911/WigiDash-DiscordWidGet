# Normalizar line endings para todos os arquivos de texto
* text=auto

# Arquivos C# e .NET - usar LF
*.cs text eol=lf
*.csproj text eol=lf
*.sln text eol=lf

# Arquivos XAML e XML - usar LF
*.xaml text eol=lf
*.xml text eol=lf

# Arquivos de configuração - usar LF
*.json text eol=lf
*.config text eol=lf

# Scripts PowerShell - usar LF
*.ps1 text eol=lf

# Markdown e documentação - usar LF
*.md text eol=lf

# Arquivos binários (não converter)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.dll binary
*.exe binary
*.pdb binary
