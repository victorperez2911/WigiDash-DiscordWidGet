<UserControl x:Class="WigiDash.DiscordWidget.UI.DiscordSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="500"
             Background="#FF2D2D30">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title -->
                <RowDefinition Height="Auto"/> <!-- Action Type Selection -->
                <RowDefinition Height="Auto"/> <!-- Auth Section -->
                <RowDefinition Height="Auto"/> <!-- Type-Specific Panel (Dynamic) -->
                <RowDefinition Height="Auto"/> <!-- Apply Button -->
                <RowDefinition Height="*"/>    <!-- Info -->
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Discord Widget Settings"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,15"/>

            <!-- Action Type Selection -->
            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="Action Type:"
                           Foreground="White"
                           FontSize="12"
                           Margin="0,0,0,5"/>
                <ComboBox x:Name="ActionTypeComboBox"
                          Height="30"
                          Background="#FF3E3E42"
                          Foreground="White"
                          BorderBrush="#FF007ACC"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="ActionId"/>
            </StackPanel>

            <!-- Authentication Section -->
            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Discord Authentication:"
                           Foreground="White"
                           FontSize="12"
                           Margin="0,0,0,5"/>

                <Button x:Name="LoginButton"
                        Content="Login with Discord"
                        Height="35"
                        Background="#FF5865F2"
                        Foreground="White"
                        BorderThickness="0"
                        FontSize="13"
                        FontWeight="Bold"
                        Cursor="Hand"/>

                <TextBlock x:Name="AuthStatusText"
                           Text="Not authenticated"
                           Foreground="#FF808080"
                           FontSize="10"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Type-Specific Configuration Panel (Dynamic) -->
            <Border Grid.Row="3"
                    x:Name="TypeSpecificPanelContainer"
                    Margin="0,0,0,15">
                <!-- Content loaded dynamically based on action type -->
            </Border>

            <!-- Apply Button -->
            <Button Grid.Row="4"
                    x:Name="ApplyButton"
                    Content="Apply Settings"
                    Height="30"
                    Background="#FF007ACC"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="12"
                    FontWeight="Bold"
                    Cursor="Hand"
                    IsEnabled="False"
                    Margin="0,5,0,15"/>

            <!-- Info -->
            <Border Grid.Row="5"
                    Background="#FF252526"
                    BorderBrush="#FF3E3E42"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="10">
                <TextBlock x:Name="InfoText"
                           TextWrapping="Wrap"
                           Foreground="#FFCCCCCC"
                           FontSize="11"
                           LineHeight="18"
                           Text="Select an action type to get started."/>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
